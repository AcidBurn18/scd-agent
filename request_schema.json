{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD Generation Request",
  "description": "JSON schema for SCD generation requests uploaded to Azure Storage",
  "type": "object",
  "required": ["azure_service"],
  "properties": {
    "azure_service": {
      "type": "string",
      "description": "The Azure service name for SCD generation",
      "examples": [
        "Azure Key Vault",
        "Azure Storage",
        "Azure SQL Database",
        "Azure App Service",
        "Azure Functions"
      ]
    },
    "additional_context": {
      "type": "string",
      "description": "Additional context or requirements for SCD generation",
      "default": ""
    },
    "auto_collect": {
      "type": "boolean",
      "description": "Whether to automatically collect data about the service",
      "default": true
    },
    "store_in_azure": {
      "type": "boolean", 
      "description": "Whether to store the generated SCD in Azure Storage",
      "default": true
    },
    "github_integration": {
      "type": "object",
      "description": "GitHub integration settings (optional)",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable GitHub integration",
          "default": false
        },
        "branch_name": {
          "type": "string",
          "description": "Branch name for the pull request",
          "default": "scd-update-{service}-{timestamp}"
        },
        "commit_message": {
          "type": "string",
          "description": "Commit message",
          "default": "Update SCD for {service}"
        },
        "pr_title": {
          "type": "string",
          "description": "Pull request title",
          "default": "SCD Update: {service}"
        },
        "pr_description": {
          "type": "string",
          "description": "Pull request description",
          "default": "Automated SCD generation for {service}"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata for tracking",
      "properties": {
        "requestor": {
          "type": "string",
          "description": "Name or ID of the requestor"
        },
        "project": {
          "type": "string", 
          "description": "Project name or identifier"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "urgent"],
          "default": "medium"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags for categorization"
        }
      }
    }
  }
}